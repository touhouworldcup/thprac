#include "winres.h"
#include "src/thprac_version.h"

#define STRR(X) #X
#define STR(X) STRR(X) 

VS_VERSION_INFO VERSIONINFO
 FILEVERSION THPRAC_VERSION_0,THPRAC_VERSION_1,THPRAC_VERSION_2,THPRAC_VERSION_3
 PRODUCTVERSION THPRAC_VERSION_0,THPRAC_VERSION_1,THPRAC_VERSION_2,THPRAC_VERSION_3
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            VALUE "FileVersion", STR(THPRAC_VERSION_0) "." STR(THPRAC_VERSION_1) "." STR(THPRAC_VERSION_2) "." STR(THPRAC_VERSION_3)
            VALUE "ProductVersion", STR(THPRAC_VERSION_0) "." STR(THPRAC_VERSION_1) "." STR(THPRAC_VERSION_2) "." STR(THPRAC_VERSION_3)
			VALUE "FileDescription", "Touhou Practice Tool"
			VALUE "InternalName", "thprac.exe"
            VALUE "OriginalFilename", "thprac.exe"
            VALUE "ProductName", "thprac"
			VALUE "LegalCopyright", "All thprac developers"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1200
    END
END
